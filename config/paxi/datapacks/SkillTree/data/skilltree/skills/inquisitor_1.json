      },
      "f_131102_": false,
      "f_131104_": false,
      "f_131105_": false,
      "f_131106_": false,
      "text": "△ Усиление △"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+6% к урону в ближнем бою"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+20% к сопротивлению заклинаниям"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": ""
    },
    {
      "f_131101_": {
        "f_131257_": 14931153
      },
      "text": "▽ Ослабление ▽"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "-25% к восстановлению маны"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "-90% к силе заклинаний, если вы надели Кольцо Семи проклятий"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "Нельзя использовать реактивные ранцы"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "Нельзя использовать картофельную пушку, механические арбалеты, заводные крылья, огнемет"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "У вас нет доступа к механической броне"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "У вас нет доступа к магии потусторонья"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "Магия святости ослаблена"
    }
  ]
