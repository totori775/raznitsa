  "description": [
    {
      "f_131101_": {
        "f_131257_": 14931153
      },
      "text": "△ Усиление △"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+30 к запасу маны"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+5% к восстановлению маны"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": ""
    },
    {
      "f_131101_": {
        "f_131257_": 14931153
      },
      "text": "▽ Ослабление ▽"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "-25% к урону"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "-60% к силе заклинаний, если на вас надето Кольцо Семи проклятий"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "Нельзя использовать реактивные ранцы"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "Нельзя использовать картофельную пушку, механические арбалеты, заводные крылья, огнемёт"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "и некоторое огнестрельное оружие"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "У вас нет доступа к механической броне"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "Вам недоступна потусторонняя магия"
    }
  ]
