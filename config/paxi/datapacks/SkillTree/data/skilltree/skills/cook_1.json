      },
      "text": "△ Усиление △"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+2 к броне"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+4 к максимальному здоровью"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "Вам доступен Техномагический посох"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": ""
    },
    {
      "f_131101_": {
        "f_131257_": 14931153
      },
      "text": "▽ Ослабление ▽"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "-10% к восстановлению маны"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "-20% к силе заклинаний"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "Нельзя использовать величественные крылья"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "Нельзя использовать книги заклинаний, кроме Хлипкого журнала"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "У вас нет доступа к магии потусторонья"
    },
    {
      "f_131101_": {
        "f_131257_": 16733525
      },
      "text": "У вас нет доступа к броне боевого мага"
    }
  ]
