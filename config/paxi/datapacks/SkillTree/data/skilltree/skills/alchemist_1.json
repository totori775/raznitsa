      },
      "text": "△ Усиление △"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+10% к урону в ближнем бою"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "+20% к сопротивлению отбрасывания"
    },
    {
      "f_131101_": {
        "f_131257_": 8092645
      },
      "text": "Вам доступен Необузданный голод"
    },
    {
      "f_131101_": {
        "f_131257_": 14931153
      },
      "text": ""
    },
    {
      "f_131101_": {
        "f_131257_": 14931153
      },
      "text": "▽ Ослабление ▽"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "-20% к восстановлению маны"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "-30% к силе заклинаний"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "Нельзя использовать реактивные ранцы"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "Нельзя использовать картофельную пушку, механические арбалеты, заводные крылья, огнемёт"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "У вас нет доступа к механической броне"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "У вас нет доступа к магии потусторонья"
    },
    {
      "f_131101_": {
        "f_131257_": 14834266
      },
      "text": "Магия святости ослаблена"
    }
  ]
